{
  "name": "aftermerge",
  "version": "0.1.0",
  "description": "Measure the post-merge durability of agent-authored pull requests.",
  "keywords": [
    "github-actions",
    "ai-coding-agents",
    "engineering-analytics",
    "pull-requests"
  ],
  "homepage": "https://github.com/PtPetrov/aftermerge-#readme",
  "bugs": {
    "url": "https://github.com/PtPetrov/aftermerge-/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PtPetrov/aftermerge-.git"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "aftermerge": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
